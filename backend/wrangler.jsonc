{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clams-api",
  // Points at the tsc output, not src: tsc emits the decorator metadata Nest
  // needs to inject by type, and esbuild does not. Run `npm run build:workers`
  // before deploying.
  "main": "dist-workers/workers-entry.js",

  // 2026-08-04 and later turns on nodejs_compat and nodejs_compat_v2 by
  // default, which is what makes node:crypto, node:stream and the node:http
  // server modules available. Express and Nest need all three.
  "compatibility_date": "2026-09-01",

  "observability": { "enabled": true },

  // @nestjs/core lazily requires its optional transport packages, and
  // class-transformer's storage subpath is not listed in its package exports.
  // Neither resolves in a bundler; both are pointed somewhere real here.
  "alias": {
    "@nestjs/microservices": "./dist-workers/workers-stubs/nest-optional.js",
    "@nestjs/microservices/microservices-module": "./dist-workers/workers-stubs/nest-optional.js",
    "@nestjs/websockets/socket-module": "./dist-workers/workers-stubs/nest-optional.js",
    "class-transformer/storage": "./node_modules/class-transformer/cjs/storage.js",
    // sharp is a native addon. The Images binding does the same job here.
    "./image-compressor": "./dist-workers/modules/files/image-compressor.workers.js",
    // The Node store reaches R2 over the S3 API and needs credentials; the
    // binding needs none and keeps the SDK out of the bundle.
    "./blob-store": "./dist-workers/modules/files/blob-store.workers.js",
    // iconv-lite's lazy stream require breaks when bundled, and body-parser
    // drags it in through @nestjs/platform-express whether or not it is used.
    "iconv-lite": "./dist-workers/workers-stubs/iconv-lite.js",
    // firebase-admin speaks gRPC; this one signs its own JWT and posts to FCM.
    "./push-sender": "./dist-workers/common/push/push-sender.workers.js",
    // ioredis holds a TCP connection open and heals itself on timers. Neither
    // survives an isolate that is frozen between requests, so this one issues
    // each command as an ordinary HTTPS call to Upstash's REST endpoint.
    "./redis-client": "./dist-workers/infra/redis/redis-client.workers.js",
    // pdfkit's default build reads the base-14 font metrics off disk —
    // `fs.readFileSync(__dirname + '/data/Helvetica.afm')` — the moment a
    // document picks a font. There is no __dirname and no disk here, so every
    // PDF threw "ReferenceError: __dirname is not defined" and the panel showed
    // "Internal server error". The standalone build is the same library with
    // those metrics inlined at pack time, which is what a runtime without a
    // filesystem needs. CSV and XLSX never touched this, which is why the
    // breakage was confined to the PDF button.
    "pdfkit": "./node_modules/pdfkit/js/pdfkit.standalone.js"
  },

  // The three background monitors cannot use setInterval here — a timer set
  // during module evaluation belongs to no request and the runtime refuses it.
  // These schedules drive the same checks through the scheduled() handler.
  "triggers": {
    "crons": ["*/10 * * * *", "*/30 * * * *", "0 3 * * *"]
  },

  "vars": {
    "NODE_ENV": "production",
    "DISABLE_INTERVAL_MONITORS": "1",
    "BETTER_AUTH_ENABLED": "1",
    "BETTER_AUTH_URL": "https://clams-api.opticspace09.workers.dev",
    // Hosts a password-reset link may point at. The panel is the only one.
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://clams-admin.opticspace09.workers.dev"
  },

  // Secrets are NOT set here — they go in via `wrangler secret put`:
  //   DATA_ENCRYPTION_KEY, BETTER_AUTH_SECRET, GMAIL_USER, GMAIL_APP_PASSWORD,
  //   FIREBASE_SERVICE_ACCOUNT, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
  //
  // There is deliberately no DATABASE_URL among them. D1 is the only database,
  // and it arrives as a binding rather than a connection string — so a Worker
  // that somehow tried to open Postgres would have nowhere to connect to.

  // Worker and Aadhaar photos, and the APK the admin panel serves. The APK
  // cannot be a static asset: those are capped at 25 MiB and it is 72 MB.
  // The application database. Hyperdrive and its Postgres stay declared for
  // now so a rollback is a config change rather than a redeploy of code that
  // no longer exists.
  // The database. The only one.
  "d1_databases": [
    { "binding": "DB", "database_name": "clams-d1", "database_id": "13ee2585-428a-4a94-a5d2-a6f83f2d061f" }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clams-media" }],

  // Replaces sharp for photo compression.
  // "images": { "binding": "IMAGES" }
}
