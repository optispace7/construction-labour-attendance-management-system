// CLAMS Prisma schema — implements docs/02-database-schema.md
generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Lets the client talk to Postgres through a plain JS driver instead of the
  // Rust query engine. The engine is a native binary, so it cannot run on a
  // runtime that only loads JS and WebAssembly; the adapter is what makes the
  // same code work both on a normal Node server and on that kind of runtime.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------
enum UserRole {
  SUPER_ADMIN
  SITE_ADMIN
  WATCHMAN
  SUPERVISOR
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  EXITED
  SUSPENDED
}

enum DeviceStatus {
  PENDING
  AUTHORIZED
  REVOKED
}

enum SessionState {
  OPEN
  CLOSED
  AUTO_CLOSED
  VOID
}

enum TapType {
  LOGIN
  LOGOUT
}

enum TapSource {
  NFC_UID
  NFC_NDEF
  QR
  MANUAL
}

enum VerificationMode {
  MANUAL
  AUTO
}

enum PhotoVerifyMode {
  ALWAYS
  NEVER
  RANDOM
}

enum CorrectionType {
  LOGIN
  LOGOUT
  MISSING
  WRONG_SITE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CorrectionReason {
  FORGOT_CARD
  DEVICE_ISSUE
  NETWORK_ISSUE
  WRONG_SITE
  SUPERVISOR_MISTAKE
  OTHER
}

enum SyncEventStatus {
  ACCEPTED
  DUPLICATE
  CONFLICT
  REJECTED
}

enum ManualApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CredentialKind {
  NFC_UID
  QR
}

enum PersonCategory {
  WORKER
  STAFF
  VISITOR
}

enum PhotoKind {
  PROFILE
  AADHAAR_FRONT
  AADHAAR_BACK
  ID_PROOF
}

// ---------------- Master data ----------------
model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  code         String   @unique
  timezone     String   @default("Asia/Kolkata")
  isActive     Boolean  @default(true) @map("is_active")
  // Company profile printed on ID cards (front-side header).
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  pincode      String?
  phone        String?
  email        String?
  website      String?
  logoUrl      String?  @map("logo_url")
  // Print-time zoom for the logo on the ID card (1 = fit, >1 zooms in).
  logoScale    Float    @default(1) @map("logo_scale")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sites      Site[]
  vendors    Vendor[]
  users      User[]
  workers    Worker[]
  devices    Device[]
  wasteTypes WasteType[]

  @@map("organizations")
}

model Site {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  code            String
  timezone        String   @default("Asia/Kolkata")
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?     @map("geofence_radius_m")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization              @relation(fields: [organizationId], references: [id])
  settings      SiteSettings?
  shifts        Shift[]
  devices       Device[]
  assignments   WorkerSiteAssignment[]
  sessions      AttendanceSession[]       @relation("SessionSite")
  scopes        UserSiteScope[]
  manualTaps    ManualAttendanceRequest[]
  safetyEntries DailySafetyEntry[]
  wasteEntries  DailyWasteEntry[]
  documents     CompanyDocument[]

  @@unique([organizationId, code])
  @@map("sites")
}

model Vendor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String
  contactPerson  String?  @map("contact_person")
  contactNumber  String?  @map("contact_number")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id])
  workers      Worker[]
  assignments  WorkerSiteAssignment[]

  @@unique([organizationId, code])
  @@map("vendors")
}

model Designation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workers Worker[]

  @@unique([organizationId, name])
  @@map("designations")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  role                UserRole
  fullName            String    @map("full_name")
  email               String?   @unique
  // Login handle for users without an email (watchmen). Globally unique so
  // login can resolve it without an org context.
  username            String?   @unique
  phone               String?
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  /// Attendance corrections this person files are applied on the spot instead
  /// of waiting for an approver. Granted per person by the Super Admin, never
  /// by role: the exemption belongs to the individual who was trusted with it,
  /// so the next holder of the same job does not inherit it silently.
  canApplyCorrections Boolean   @default(false) @map("can_apply_corrections")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id])
  siteScopes     UserSiteScope[]
  refreshTokens  RefreshToken[]
  devices        Device[]
  passwordResets PasswordReset[]

  @@map("users")
}

// One-time email OTP for self-service password reset (admins/safety officers).
// Watchmen have no email — an admin resets their password instead.
model PasswordReset {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  otpHash        String    @map("otp_hash")
  resetTokenHash String?   @map("reset_token_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  usedAt         DateTime? @map("used_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model UserSiteScope {
  userId String @map("user_id") @db.Uuid
  siteId String @map("site_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_site_scopes")
}

model Device {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String?      @map("site_id") @db.Uuid
  deviceUid      String       @map("device_uid")
  label          String?
  platform       String?
  // Owning user (set on register): approvals are role-gated — devices of a
  // SITE_ADMIN can only be authorized by a SUPER_ADMIN.
  userId         String?      @map("user_id") @db.Uuid
  status         DeviceStatus @default(PENDING)
  tokenHash      String?      @map("token_hash")
  authorizedBy   String?      @map("authorized_by") @db.Uuid
  authorizedAt   DateTime?    @map("authorized_at") @db.Timestamptz
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id])
  site         Site?           @relation(fields: [siteId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  taps         AttendanceTap[]

  @@unique([organizationId, deviceUid])
  @@map("devices")
}

// ---------------- Workers ----------------
model Worker {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  workerCode             String         @map("worker_code")
  nfcUid                 String?        @map("nfc_uid")
  qrIdentifier           String?        @map("qr_identifier")
  fullName               String         @map("full_name")
  fatherName             String?        @map("father_name")
  gender                 String?
  dateOfBirth            DateTime?      @map("date_of_birth") @db.Date
  language               String?
  photoUrl               String?        @map("photo_url")
  mobileNumber           String?        @map("mobile_number")
  // Work e-mail, printed as the "Mail Id" line on the staff ID card.
  email                  String?
  pincode                String?
  bloodGroup             String?        @map("blood_group")
  emergencyContactName   String?        @map("emergency_contact_name")
  emergencyContactNumber String?        @map("emergency_contact_number")
  screeningDoneOn        DateTime?      @map("screening_done_on") @db.Date
  screeningDoneBy        String?        @map("screening_done_by")
  inductionDoneOn        DateTime?      @map("induction_done_on") @db.Date
  inductedBy             String?        @map("inducted_by")
  validityTill           DateTime?      @map("validity_till") @db.Date
  nomineeName            String?        @map("nominee_name")
  nomineeRelation        String?        @map("nominee_relation")
  vendorId               String?        @map("vendor_id") @db.Uuid
  designationId          String?        @map("designation_id") @db.Uuid
  category               PersonCategory @default(WORKER)
  natureOfContractor     String?        @map("nature_of_contractor")
  bankName               String?        @map("bank_name")
  // bankAccountNumber is being migrated to bankAccountCiphertext (encrypted at
  // rest); kept temporarily as the backfill source, dropped after migration.
  bankAccountNumber      String?        @map("bank_account_number")
  bankAccountCiphertext  Bytes?         @map("bank_account_ciphertext")
  bankAccountLast4       String?        @map("bank_account_last4")
  ifscCode               String?        @map("ifsc_code")
  pfNumber               String?        @map("pf_number")
  esiNumber              String?        @map("esi_number")
  govIdType              String?        @map("gov_id_type")
  aadhaarCiphertext      Bytes?         @map("aadhaar_ciphertext")
  aadhaarLast4           String?        @map("aadhaar_last4")
  // Aadhaar card images (compressed + encrypted PhotoBlobs). Front is the
  // primary; back is optional and may be added/updated independently.
  aadhaarFrontPhotoId    String?        @map("aadhaar_front_photo_id") @db.Uuid
  aadhaarBackPhotoId     String?        @map("aadhaar_back_photo_id") @db.Uuid
  panCiphertext          Bytes?         @map("pan_ciphertext")
  panLast4               String?        @map("pan_last4")
  // Visitor-only fields: escort is mandatory for visitors (enforced in the
  // DTO/UI), company is free text, ID-proof photo is an optional PhotoBlob.
  escortName             String?        @map("escort_name")
  visitorCompany         String?        @map("visitor_company")
  idProofPhotoId         String?        @map("id_proof_photo_id") @db.Uuid
  status                 WorkerStatus   @default(ACTIVE)
  joinDate               DateTime?      @map("join_date") @db.Date
  exitDate               DateTime?      @map("exit_date") @db.Date
  notes                  String?
  createdById            String?        @map("created_by_id") @db.Uuid
  updatedById            String?        @map("updated_by_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz

  organization Organization              @relation(fields: [organizationId], references: [id])
  vendor       Vendor?                   @relation(fields: [vendorId], references: [id])
  designation  Designation?              @relation(fields: [designationId], references: [id])
  assignments  WorkerSiteAssignment[]
  credentials  WorkerCredential[]
  sessions     AttendanceSession[]
  taps         AttendanceTap[]
  corrections  CorrectionRequest[]
  manualTaps   ManualAttendanceRequest[]

  @@unique([organizationId, workerCode])
  @@index([organizationId, mobileNumber])
  @@index([organizationId, category])
  @@map("workers")
}

model WorkerSiteAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  workerId  String    @map("worker_id") @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  vendorId  String?   @map("vendor_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isPrimary Boolean   @default(true) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  worker Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site   Site    @relation(fields: [siteId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@map("worker_site_assignments")
}

model WorkerCredential {
  id        String         @id @default(uuid()) @db.Uuid
  workerId  String         @map("worker_id") @db.Uuid
  kind      CredentialKind
  value     String
  isActive  Boolean        @default(true) @map("is_active")
  issuedAt  DateTime       @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz
  reason    String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_credentials")
}

// ---------------- Settings / shifts ----------------
model Shift {
  id                 String   @id @default(uuid()) @db.Uuid
  siteId             String   @map("site_id") @db.Uuid
  name               String
  startTime          DateTime @map("start_time") @db.Time
  endTime            DateTime @map("end_time") @db.Time
  isOvernight        Boolean  @default(false) @map("is_overnight")
  lateGraceMinutes   Int      @default(0) @map("late_grace_minutes")
  earlyGraceMinutes  Int      @default(0) @map("early_grace_minutes")
  otThresholdMinutes Int      @default(0) @map("ot_threshold_minutes")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  site            Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]
  defaultForSites SiteSettings[]      @relation("DefaultShift")

  @@map("shifts")
}

model SiteSettings {
  siteId                      String           @id @map("site_id") @db.Uuid
  verificationMode            VerificationMode @default(MANUAL) @map("verification_mode")
  autoLoginCountdownSeconds   Int              @default(10) @map("auto_login_countdown_seconds")
  duplicateTapCooldownSeconds Int              @default(30) @map("duplicate_tap_cooldown_seconds")
  // Minimum minutes between a worker's login and their logout (and between a
  // logout and the next login). The cooldown above swallows a double scan a
  // second later; this catches the one that lands a minute later. 0 = off.
  safetyGapMinutes            Int              @default(10) @map("safety_gap_minutes")
  geoEnforcement              Boolean          @default(false) @map("geo_enforcement")
  geoRadiusMeters             Int              @default(200) @map("geo_radius_meters")
  photoVerificationMode       PhotoVerifyMode  @default(RANDOM) @map("photo_verification_mode")
  photoVerificationRandomPct  Int              @default(20) @map("photo_verification_random_pct")
  defaultShiftId              String?          @map("default_shift_id") @db.Uuid
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  site         Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  defaultShift Shift? @relation("DefaultShift", fields: [defaultShiftId], references: [id])

  @@map("site_settings")
}

// ---------------- Attendance ----------------
model AttendanceTap {
  id               String            @id @default(uuid()) @db.Uuid
  eventId          String            @map("event_id") @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  siteId           String            @map("site_id") @db.Uuid
  deviceId         String?           @map("device_id") @db.Uuid
  // Snapshot of the device's name, written only when that device is deleted —
  // device_id is SET NULL on delete, and this is what survives it.
  deviceLabel      String?           @map("device_label")
  workerId         String?           @map("worker_id") @db.Uuid
  rawIdentifier    String?           @map("raw_identifier")
  tapSource        TapSource         @map("tap_source")
  tapType          TapType?          @map("tap_type")
  clientEventTime  DateTime          @map("client_event_time") @db.Timestamptz
  serverReceivedAt DateTime          @default(now()) @map("server_received_at") @db.Timestamptz
  monotonicMs      BigInt?           @map("monotonic_ms")
  latitude         Float?
  longitude        Float?
  geoAccuracyM     Float?            @map("geo_accuracy_m")
  verifiedMode     VerificationMode? @map("verified_mode")
  photoCapturedUrl String?           @map("photo_captured_url")
  isManualBackup   Boolean           @default(false) @map("is_manual_backup")
  manualReason     String?           @map("manual_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  device        Device?                  @relation(fields: [deviceId], references: [id])
  worker        Worker?                  @relation(fields: [workerId], references: [id])
  loginSession  AttendanceSession?       @relation("LoginTap")
  logoutSession AttendanceSession?       @relation("LogoutTap")
  manualRequest ManualAttendanceRequest?

  @@unique([organizationId, eventId])
  @@index([workerId, clientEventTime(sort: Desc)])
  @@index([siteId, serverReceivedAt(sort: Desc)])
  @@map("attendance_taps")
}

model AttendanceSession {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  workerId               String       @map("worker_id") @db.Uuid
  siteId                 String       @map("site_id") @db.Uuid
  shiftId                String?      @map("shift_id") @db.Uuid
  workDate               DateTime     @map("work_date") @db.Date
  loginTapId             String?      @unique @map("login_tap_id") @db.Uuid
  logoutTapId            String?      @unique @map("logout_tap_id") @db.Uuid
  loginAt                DateTime     @map("login_at") @db.Timestamptz
  logoutAt               DateTime?    @map("logout_at") @db.Timestamptz
  state                  SessionState @default(OPEN)
  workedMinutes          Int?         @map("worked_minutes")
  overtimeMinutes        Int?         @map("overtime_minutes")
  lateMinutes            Int?         @map("late_minutes")
  earlyLeaveMinutes      Int?         @map("early_leave_minutes")
  logoutSiteId           String?      @map("logout_site_id") @db.Uuid
  isCrossSite            Boolean      @default(false) @map("is_cross_site")
  closedReason           String?      @map("closed_reason")
  forgotLogoutNotifiedAt DateTime?    @map("forgot_logout_notified_at") @db.Timestamptz
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  worker      Worker                    @relation(fields: [workerId], references: [id])
  site        Site                      @relation("SessionSite", fields: [siteId], references: [id])
  shift       Shift?                    @relation(fields: [shiftId], references: [id])
  loginTap    AttendanceTap?            @relation("LoginTap", fields: [loginTapId], references: [id])
  logoutTap   AttendanceTap?            @relation("LogoutTap", fields: [logoutTapId], references: [id])
  corrections CorrectionRequest[]
  manualTaps  ManualAttendanceRequest[]

  @@index([workerId, workDate])
  @@index([siteId, workDate])
  @@map("attendance_sessions")
}

/// A manual punch a watchman entered by hand instead of scanning a badge, held
/// until a Safety Officer (or an admin) accepts it.
///
/// Typing a worker code is the one way into attendance that no badge stands
/// behind, so it does not move attendance on its own: the tap is persisted as
/// evidence, and the session is created (LOGIN) or closed (LOGOUT) only when
/// this row is APPROVED. A REJECTED row leaves attendance exactly as it was.
///
/// `sessionId` means different things by direction, because the session exists
/// at different times: for a LOGOUT it is the open session the punch would
/// close, pinned when the request is filed; for a LOGIN it is filled in on
/// approval with the session that was created.
///
/// A partial unique index (raw SQL, see migration 7) allows only ONE PENDING row
/// per worker — a second manual punch for someone already awaiting review is
/// refused at the gate rather than queued behind the first.
model ManualAttendanceRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  siteId         String               @map("site_id") @db.Uuid
  workerId       String               @map("worker_id") @db.Uuid
  tapId          String               @unique @map("tap_id") @db.Uuid
  tapType        TapType              @map("tap_type")
  sessionId      String?              @map("session_id") @db.Uuid
  recordedAt     DateTime             @map("recorded_at") @db.Timestamptz
  reason         String?
  deviceId       String?              @map("device_id") @db.Uuid
  status         ManualApprovalStatus @default(PENDING)
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at") @db.Timestamptz
  reviewNotes    String?              @map("review_notes")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  worker  Worker             @relation(fields: [workerId], references: [id])
  site    Site               @relation(fields: [siteId], references: [id])
  tap     AttendanceTap      @relation(fields: [tapId], references: [id])
  session AttendanceSession? @relation(fields: [sessionId], references: [id])

  @@index([organizationId, status])
  @@index([workerId, status])
  @@map("manual_attendance_requests")
}

// ---------------- Corrections ----------------
model CorrectionRequest {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  workerId       String           @map("worker_id") @db.Uuid
  siteId         String           @map("site_id") @db.Uuid
  sessionId      String?          @map("session_id") @db.Uuid
  workDate       DateTime         @map("work_date") @db.Date
  type           CorrectionType
  reason         CorrectionReason
  notes          String?
  requestedBy    String           @map("requested_by") @db.Uuid
  status         CorrectionStatus @default(PENDING)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz
  reviewNotes    String?          @map("review_notes")
  /// Applied by its own author under canApplyCorrections — nobody else looked
  /// at it. Stored rather than derived from requestedBy = reviewedBy so the
  /// Super Admin's review list is one indexed query, and so revoking the
  /// permission later cannot change what the history says happened.
  autoApplied    Boolean          @default(false) @map("auto_applied")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  worker  Worker             @relation(fields: [workerId], references: [id])
  session AttendanceSession? @relation(fields: [sessionId], references: [id])
  items   CorrectionItem[]

  @@index([status, organizationId])
  @@index([organizationId, autoApplied, createdAt(sort: Desc)])
  @@map("correction_requests")
}

model CorrectionItem {
  id            String @id @default(uuid()) @db.Uuid
  requestId     String @map("request_id") @db.Uuid
  field         String
  proposedValue Json   @map("proposed_value")
  previousValue Json?  @map("previous_value")

  request CorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("correction_items")
}

// ---------------- Audit ----------------
model AuditLog {
  id             BigInt    @id @default(autoincrement())
  organizationId String?   @map("organization_id") @db.Uuid
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  actorRole      UserRole? @map("actor_role")
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  oldValue       Json?     @map("old_value")
  newValue       Json?     @map("new_value")
  reason         String?
  ipAddress      String?   @map("ip_address")
  deviceId       String?   @map("device_id") @db.Uuid
  requestId      String?   @map("request_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------- Sync ----------------
model SyncBatch {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz
  eventCount Int      @map("event_count")
  accepted   Int      @default(0)
  duplicates Int      @default(0)
  conflicts  Int      @default(0)
  rejected   Int      @default(0)

  events SyncEvent[]

  @@map("sync_batches")
}

model SyncEvent {
  id      String          @id @default(uuid()) @db.Uuid
  batchId String          @map("batch_id") @db.Uuid
  eventId String          @map("event_id") @db.Uuid
  status  SyncEventStatus
  detail  String?
  tapId   String?         @map("tap_id") @db.Uuid

  batch SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("sync_events")
}

// ---------------- Auth ----------------
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  deviceId   String?   @map("device_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------- Files (photos stored in Postgres) ----------------
model PhotoBlob {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  mimeType          String    @map("mime_type")
  // Where the bytes actually live.
  //
  // `storageKey` names an object in the media bucket and is how new images are
  // stored. `data` is the old in-database column, kept nullable so rows written
  // before the move still serve; nothing writes it any more.
  //
  // The row stays either way, and that is deliberate: it carries the
  // organizationId that scopes access, and the sizes the storage report counts.
  // Reading straight from the bucket by id would bypass both.
  storageKey        String?   @map("storage_key")
  data              Bytes?
  sizeBytes         Int       @map("size_bytes")
  // Storage-management metadata. `sizeBytes` is the stored (compressed +
  // possibly encrypted) length; `originalSizeBytes` is what the client sent.
  kind              PhotoKind @default(PROFILE)
  isCompressed      Boolean   @default(false) @map("is_compressed")
  isEncrypted       Boolean   @default(false) @map("is_encrypted")
  originalSizeBytes Int?      @map("original_size_bytes")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("photo_blobs")
}

// ---------------- SOS & notifications ----------------
model SosEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  siteId         String?   @map("site_id") @db.Uuid
  siteName       String?   @map("site_name")
  latitude       Float?
  longitude      Float?
  geoAccuracyM   Float?    @map("geo_accuracy_m")
  deviceUid      String?   @map("device_uid")
  deviceName     String?   @map("device_name")
  senderName     String?   @map("sender_name")
  senderRole     String?   @map("sender_role")
  senderEmail    String?   @map("sender_email")
  message        String?
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("sos_events")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           String
  title          String
  body           String
  siteId         String?   @map("site_id") @db.Uuid
  data           Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  readAt         DateTime? @map("read_at") @db.Timestamptz
  readBy         String?   @map("read_by") @db.Uuid

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}

// FCM device tokens for SOS push (so alerts ring even when the app is closed).
model PushToken {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  deviceUid      String?  @map("device_uid")
  token          String   @unique
  platform       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId])
  @@map("push_tokens")
}

// ---------------- Safety statistics ----------------

/// Everything the safety board tracks for one day, one metric at a time.
///
/// Three of these are derived from attendance and never typed in
/// (DAILY_MANPOWER, TOTAL_MANPOWER, TOTAL_SAFE_MAN_HOURS); the rest are the
/// Safety Officer's daily count. Both kinds get a row here so the automated ones
/// can still carry a comment, and a derived row leaves `value` null rather than
/// caching a number that attendance can change under it.
enum SafetyMetric {
  // Derived from attendance — value is computed on read, never stored.
  DAILY_MANPOWER
  TOTAL_MANPOWER
  TOTAL_SAFE_MAN_HOURS
  // Entered by the Safety Officer.
  LABOUR_INDUCTION
  TOOLBOX_TALK
  WORK_PERMIT
  UNSAFE_ACTS
  UNSAFE_CONDITIONS
  UNSAFE_ACTS_CLOSED
  UNSAFE_CONDITIONS_CLOSED
  SAFETY_OBSERVATION
  SAFETY_OBSERVATION_CLOSED
  NEAR_MISS
  FIRST_AID
  MEDICAL_TREATMENT_CASE
  LOST_TIME_INJURY
  SAFETY_INSPECTION
  WASTE_DISPOSAL
  VISITOR_INDUCTION
  SAFETY_AUDIT
  TRAINING
}

/// One metric, one site, one day.
///
/// Deliberately tall rather than a row of twenty-one columns: the brief asks for
/// Edit / Delete / View on every individual item across every date, which is a
/// row operation here and a partial-column update in the wide shape. It also
/// means a twenty-second metric costs an enum value, not a migration.
///
/// A missing row means "not filled in", which is a different thing from a row
/// holding zero — zero unsafe acts is a claim the officer made, and the stats
/// page is entitled to say so.
model DailySafetyEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  entryDate      DateTime     @map("entry_date") @db.Date
  metric         SafetyMetric
  /// Null for the derived metrics, and for a comment-only row.
  value          Int?
  comment        String?
  recordedById   String?      @map("recorded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id])

  @@unique([siteId, entryDate, metric])
  @@index([organizationId, entryDate])
  @@map("daily_safety_entries")
}

// The kinds of waste a site sends out — a list the client owns rather than an
// enum they would have to ask for a release to change.
//
// Renaming one rewrites history on purpose: a type is the same real-world
// stream whatever it has been called, so "Scrap" becoming "Scrap / Metal Waste"
// should not split its past in two.
model WasteType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// Where it sits in the dropdown; ties break on name.
  sortOrder      Int      @default(0) @map("sort_order")
  /// Retired rather than removed, once a day's sheet has used it.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  entries      DailyWasteEntry[]

  @@unique([organizationId, name])
  @@map("waste_types")
}

// One waste type's figure for one site on one day.
//
// The daily sheet's single "Waste disposal" count is the sum of these, still
// written to DailySafetyEntry so every existing total, chart and export keeps
// reading one place. This table is the breakdown behind that number.
model DailyWasteEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  entryDate      DateTime @map("entry_date") @db.Date
  wasteTypeId    String   @map("waste_type_id") @db.Uuid
  value          Int
  recordedById   String?  @map("recorded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site      Site      @relation(fields: [siteId], references: [id])
  wasteType WasteType @relation(fields: [wasteTypeId], references: [id])

  @@unique([siteId, entryDate, wasteTypeId])
  @@index([organizationId, entryDate])
  @@map("daily_waste_entries")
}

// ---------------- Company documents ----------------

/// A PDF the company keeps on file — a licence, an insurance policy, a works
/// contract. Stored in the database like a photo blob (same reason: one backup,
/// no second storage account to keep in sync), and watched for expiry so the
/// renewal is chased by email rather than remembered.
model CompanyDocument {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// The site this document belongs to. A licence is granted for a particular
  /// project, so it expires against that project and is chased for it.
  siteId         String  @map("site_id") @db.Uuid
  /// Display name. Seeded from the uploaded file's name; the client renames it.
  name           String
  /// The name of the file as uploaded — kept so a download reads as the
  /// original document even after the display name is changed.
  fileName       String  @map("file_name")
  mimeType       String  @map("mime_type")
  /// Where the PDF itself lives. `storageKey` names an object in the media
  /// bucket; `data` is the old in-database column, nullable so documents
  /// uploaded before the move still open. Nothing writes it any more.
  storageKey     String? @map("storage_key")
  data           Bytes?
  sizeBytes      Int     @map("size_bytes")

  /// The day the document stops being valid. Null = nothing to expire.
  validUntil       DateTime? @map("valid_until") @db.Date
  /// How many days before validUntil the reminder mail goes out.
  remindDaysBefore Int       @default(10) @map("remind_days_before")
  /// Which validity date each mail has already gone out for. Re-dating a
  /// renewed document leaves these behind, which re-arms both reminders; the
  /// monitor also claims a row by writing them, so two replicas can't both send.
  reminderSentFor  DateTime? @map("reminder_sent_for") @db.Date
  expirySentFor    DateTime? @map("expiry_sent_for") @db.Date

  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId, validUntil])
  @@index([siteId])
  @@map("company_documents")
}

// ---------------- Reports ----------------
model ReportJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestedBy    String    @map("requested_by") @db.Uuid
  reportType     String    @map("report_type")
  format         String
  params         Json
  status         String    @default("QUEUED")
  resultUrl      String?   @map("result_url")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  @@map("report_jobs")
}

// ============================================================================
// Better Auth (spike)
//
// Identity only. Authorization — organization, role, site scopes, the
// direct-apply flag — stays on User, which these rows share an id with.
//
// Deliberately not merged into User: Better Auth never writes organization_id,
// role or full_name, and its generator refuses a table that requires columns
// it does not populate. Its suggestion is to make them optional, which would
// leave every permission check reading a nullable column owned by a library.
//
// Nothing here alters an existing table, so all four foreign keys that
// reference users.id keep working untouched.
// ============================================================================

model AuthUser {
  id              String        @id @db.Uuid
  name            String
  email           String
  emailVerified   Boolean       @default(false) @map("email_verified")
  image           String?
  username        String?
  displayUsername String?       @map("display_username")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  sessions        AuthSession[]
  accounts        AuthAccount[]

  @@unique([email])
  @@unique([username])
  @@map("auth_user")
}

model AuthSession {
  id        String   @id @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([token])
  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The password hash lives here, not on the user. This is what a credential
  // login actually reads; users.password_hash is not consulted.
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("auth_verification")
}
