# Node
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.next/
# Renaming .next to .next-stale-<date> is the usual way to force a clean
# rebuild here, and the rule above does not catch the renamed copy — which
# is how 816MB of build output ended up staged for a commit once.
.next-stale-*/
out/

# Env / secrets
.env
.env.local
.env.*.local
infra/.env
# Firebase service-account key (server secret — NEVER commit; set as the API env var)
*firebase-adminsdk*.json
serviceAccount*.json
# Android release signing — keystore + credentials must NEVER be committed
*.jks
*.keystore
mobile/android/key.properties

# Android APK copied into the admin app for the /download endpoint
# (72MB binary — kept out of git; az acr build uploads it from the working tree)
admin/public/*.apk

# Prisma
backend/prisma/*.db
# Generated by the demo-open-sessions script (record of demo rows to undo)
backend/prisma/demo-open-sessions-ids.json
# Same, for the safety board's demo data — the ids name rows in one database
backend/prisma/seed-demo-safety-ids.json
backend/prisma/seed-demo-safety-ids-undone.json

# Flutter / Dart
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/ios/Pods/
mobile/android/.gradle/
*.g.dart
*.freezed.dart

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

acrlog.txt
calog.txt

# Slide decks / scratch scripts (not part of the app)
*.pptx
*.py
deck/
outputs/

# Local DB backups — contain worker PII, never commit
backups/

# Client-facing documents & scratch artifacts (not part of the app)
*.docx
*.xlsx
*.ndjson
CLAMS-Project-Context.md
DEMO-DATA-*.md
.codex-tmp/

# Wrangler local secrets — never commit
.dev.vars
.wrangler/

# Wrangler build output
backend/.wrangler/
backend/worker-configuration.d.ts

dist-workers/

# Generated Worker secrets — local record only, never commit
backend/.worker-secrets.local.json

# APK kept out of the repo; it lives in R2 and is served by /download
CLAMS.apk.local
admin/.open-next/
admin/worker-configuration.d.ts
